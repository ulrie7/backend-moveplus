                },
                "gps_id": {
                  "type": "string",
                  "description": "the gps_id of vehicle"
                },
                "image": {
                  "type": "string",
                  "format": "binary",
                  "description": "imageto upload"
                }
              },
              "required": [
                "imei",
                "image"
              ]
